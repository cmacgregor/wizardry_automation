# Wizardry Store User ID (required)
USER_ID=YOUR_USER_ID_HERE

# Country code sent at login (optional, defaults to US)
COUNTRY=US

# How often to check for free items, in hours. Already-claimed items are
# skipped, so checking often is safe. Leave empty to run once and exit.
CHECK_INTERVAL_HOURS=6

# Set to true to only list what would be claimed (optional)
DRY_RUN=false
